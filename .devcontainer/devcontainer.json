{
  "name": "Xynotransit full stack",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080, 8025],
  "portsAttributes": {
    "8080": { "label": "Xynotransit app", "onAutoForward": "openBrowser" },
    "8025": { "label": "Mailpit (sign-in emails)", "onAutoForward": "notify" }
  },
  "postStartCommand": "bash xynotransit-db/scripts/codespaces-up.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.flutter", "rust-lang.rust-analyzer"]
    }
  }
}
