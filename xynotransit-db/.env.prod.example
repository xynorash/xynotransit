# Copy to .env.prod (git ignores it) and fill every line. Run with:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# The name people type, no https:// and no slash. Its DNS record must point at this machine.
DOMAIN=reports.example.org
# The same name with https://, no slash at the end. Used inside the sign-in emails.
PUBLIC_URL=https://reports.example.org

# Database password. Letters and digits only (it goes into a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the sign-in sessions. At least 32 characters. Generate: openssl rand -hex 32
# Changing it signs everybody out.
JWT_SECRET=

# The first manager. Created (or promoted) every time the API starts. Sign in with this address.
BOOTSTRAP_CONTROLLER_EMAIL=
BOOTSTRAP_CONTROLLER_NAME=

# Mail server that sends the sign-in links. Your provider gives you these.
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587), tls (usually port 465) or none (a mail catcher, never for real mail)
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# An address your provider lets you send from
MAIL_FROM=Xynotransit <no-reply@reports.example.org>

# Optional
# IMAGE_TAG=latest              # or a commit sha from the Packages page, to pin a version
# RUST_LOG=info,sqlx=warn
# LOG_FORMAT=json               # text for plain lines
# HTTP_PORT=80
# HTTPS_PORT=443
