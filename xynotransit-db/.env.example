# Copy to .env. Values below are DEV ONLY.
POSTGRES_PASSWORD=xynotransit
# DEV ONLY default. Use a long random value (32+ chars) anywhere real.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
PUBLIC_URL=http://127.0.0.1:8080
MAIL_FROM=Xynotransit <no-reply@xynotransit.local>
# This person is created (or promoted and activated) as controller at API start.
# Optional: BOOTSTRAP_CONTROLLER_NAME. Default is the capitalised part of the email before the @.
BOOTSTRAP_CONTROLLER_EMAIL=
BOOTSTRAP_CONTROLLER_NAME=
# Logs magic links at info level. Dev only.
LOG_MAGIC_LINKS=true
RUST_LOG=info
