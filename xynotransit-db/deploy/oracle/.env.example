# Copy to .env (chmod 600 .env) and fill in. Never commit .env.

# Public host name. No domain? Use your public IP with dashes: 84-12-108-224.sslip.io
DOMAIN=

# Generate both with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# The first manager: created (or promoted) when the API starts. Sign in with this email.
BOOTSTRAP_CONTROLLER_EMAIL=
BOOTSTRAP_CONTROLLER_NAME=

# Sign-in emails. Until SMTP is set, Mailpit catches them (see docker-compose.yml for the ssh tunnel).
COMPOSE_PROFILES=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Xynotransit <no-reply@xynotransit.local>
# Real SMTP example (port 587 submission; Oracle blocks outbound port 25):
#   COMPOSE_PROFILES=
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_TLS=starttls
#   SMTP_USERNAME=...
#   SMTP_PASSWORD=...
#   MAIL_FROM=Xynotransit <no-reply@your-domain>

# Logs each sign-in link at info level. Leave false on a server others can read logs from.
LOG_MAGIC_LINKS=false
# Addresses at these domains never receive mail; people sign in with links the manager creates.
INTERNAL_EMAIL_DOMAINS=xynotransit.internal
RUST_LOG=info
